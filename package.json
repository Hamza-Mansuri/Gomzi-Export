{
  "name": "gomzi-export",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace frontend -- --host 0.0.0.0",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "preview": "npm run preview --workspace frontend -- --host 0.0.0.0",
    "typecheck": "npm run typecheck --workspace frontend",
    "test": "npm run test --workspace backend",
    "optimize": "node scripts/optimize-images.mjs",
    "generate:pdf": "node scripts/generate-company-pdf.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
